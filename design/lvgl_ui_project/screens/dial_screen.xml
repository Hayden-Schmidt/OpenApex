<screen>
    <view extends="lv_obj"
          style_width="100%" style_height="100%"
          style_bg_color="0x000000" style_bg_opa="255"
          style_border_width="0">

        <!-- Heading ring: rotates as a whole via heading_x10 subject (0.1 deg units).
             Hidden entirely when heading is unknown. -->
        <lv_obj name="heading_ring"
                width="220" height="220"
                align="top_mid" y="6"
                style_radius="110"
                style_bg_opa="0"
                style_border_width="3"
                style_border_color="0x333333">

            <bind_style_prop prop="transform_rotation" selector="main" subject="heading_x10"/>

            <lv_obj name="north_marker"
                    width="6" height="14"
                    align="top_mid" y="2"
                    style_radius="0"
                    style_bg_color="0xFF3B30"
                    style_bg_opa="255"
                    style_border_width="0"/>
        </lv_obj>

        <!-- Maneuver arrow zone: one static shape per nav_icon_t ordinal, stacked and
             toggled by visibility bound to the nav_icon subject. Only "straight" (0) is
             ported from SVG so far - remaining ordinals follow once this binding syntax
             is confirmed working in preview. -->
        <lv_obj name="arrow_zone"
                width="120" height="120"
                align="top_mid" y="30"
                style_bg_opa="0"
                style_border_width="0">

            <lv_line name="icon_straight"
                     points="(55 105) (55 34) (47 42) (40 35) (60 15) (80 35) (73 42) (65 34) (65 105) (55 105)"
                     style_line_width="10"
                     style_line_color="0xFFFFFF"
                     style_line_rounded="true">

                <bind_flag_if_not_eq subject="nav_icon" flag="hidden" ref_value="0"/>
            </lv_line>
        </lv_obj>

        <lv_label name="street_label"
                  text=""
                  align="top_mid" y="165"
                  style_text_color="0xCCCCCC"
                  style_text_font="montserrat_16"
                  bind_text="street_name"/>

        <lv_label name="distance_label"
                  text=""
                  align="top_mid" y="195"
                  style_text_color="0xFFFFFF"
                  style_text_font="montserrat_24"
                  bind_text="distance_text"/>
    </view>
</screen>
