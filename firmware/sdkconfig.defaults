CONFIG_IDF_TARGET="esp32c3"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_FREERTOS_HZ=1000
CONFIG_LVGL_ENABLE=y
# Fonts the 240px screens actually use: 18 for the odometer-page unit, 20 for the idle odometer
# bubble / odometer-page tenths,
# 28 for the heading readout and clock, 38 for the odometer digits, 44 for the idle clock
# (design/screens/02-idle, 4. Odometer page). Each built-in face costs flash, so enable a
# size only when a page needs it. Sizes must be mirrored in firmware/sim_lvgl/include/lv_conf.h or
# the simulator silently renders a page at a different size than the device does.
# The 466px RICH tier wants larger still — that needs an lv_font_conv-generated face, not another
# built-in, since LVGL's bundled Montserrat stops at 48.
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_38=y
CONFIG_LV_FONT_MONTSERRAT_44=y
# Audio, microphone, and codec features are intentionally absent from Phase 1.

# BLE: NimBLE host, peripheral role (terminal advertises and hosts the nav GATT service; the
# Android relay connects as central and writes packets in). The observer role scans for other
# terminals (rider mesh); central is unused for now — see docs/reference/decisions.md ADR-5 for why the terminal is the peripheral, not the phone.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
# CENTRAL is on not because we ever initiate a connection, but because NimBLE gates every
# ble_gattc_* symbol behind it. On iOS the terminal must be the GATT CLIENT on the phone's
# own connection to read ANCS and CTS: client/server and central/peripheral are orthogonal,
# so we stay the peripheral and still need this.
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
# Bond storage must survive reboot: the "bike on -> device boots -> phone reconnects" flow relies
# on the terminal and phone staying bonded across power cycles, not re-pairing every boot.
CONFIG_BT_NIMBLE_NVS_PERSIST=y

# -O2 rather than the -Og debug default: LVGL's software renderer is the frame-rate bottleneck on
# the single-core C3, and it runs markedly faster optimised.
CONFIG_COMPILER_OPTIMIZATION_PERF=y


# Rider mesh over BLE (docs/reference/rider_mesh_v1.md): extended advertising, so the phone's advert
# (instance 0) and the mesh's Coded-PHY advert (instance 1) run side by side, and a mesh frame (up
# to ~120 B) fits one advert. Capped at one PDU's worth rather than the 1650 B default buffer.
CONFIG_BT_NIMBLE_EXT_ADV=y
CONFIG_BT_NIMBLE_EXT_SCAN=y
CONFIG_BT_NIMBLE_MAX_EXT_ADV_INSTANCES=2
CONFIG_BT_NIMBLE_EXT_ADV_MAX_SIZE=251
