# Host test output
build/
*.obj
*.pdb

# Firecrawl / web research scratch
.firecrawl/

# Local tooling
.venv/
.env

# Ad-hoc serial/debug capture logs (e.g. c3log*.txt captures)
/logs/

# Local agent/tool state, not project source
/.claude/
/.serena/

# Python bytecode
__pycache__/
*.pyc

# Drive captures: contain the rider's route, addresses and timestamps. Never commit raw.
*.jsonl
esp_log.bin
drivelogs/

# PlatformIO regenerates these with machine-specific toolchain paths on every build
.vscode/c_cpp_properties.json
.vscode/launch.json

# Design-canvas tool state
/.design-canvas/

# Third-party screenshots used as phone app mood-board; not ours to redistribute
design reference/5. Phone App/Examples/

# Character art working files (export GUIDs, pixel-snapper/rehab passes, archive). The masters are
# the named PNGs in design reference/Characters plus Full Res Characters.png.
design reference/Characters/**/{*}*.png
design reference/Characters/**/*pixel-snapper*.png
design reference/Characters/**/*pixel-rehab*.png
design reference/Characters/archive/
