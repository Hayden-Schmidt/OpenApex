# Android / Gradle
.gradle/
**/build/
android/local.properties
*.iml
.idea/

# ESP-IDF generated files
firmware/build/
firmware/sdkconfig
firmware/sdkconfig.old
firmware/sdkconfig.prototype_c3
firmware/sdkconfig.prototype_c3_devlog
firmware/managed_components/

# PlatformIO generated files
.pio/
firmware/.pio/
sdkconfig.prototype_c3
# Anchored: an unanchored "CMakeLists.txt" matches at EVERY level, which silently swallowed
# firmware/gui/CMakeLists.txt (the gui component's source list -- without it a fresh clone cannot
# build the firmware at all). Only the PlatformIO-generated root one should be ignored.
/CMakeLists.txt
simulator/native/CMakeLists.txt

# Host test output
build/
*.obj
*.pdb

# Firecrawl / web research scratch
.firecrawl/

# Local tooling
.venv/
.env

# Ad-hoc serial/debug capture logs (e.g. c3log*.txt captures)
/logs/

# Local agent/tool state, not project source
/.claude/
/.serena/

# Python bytecode
__pycache__/
*.pyc

# Drive captures: contain the rider's route, addresses and timestamps. Never commit raw.
*.jsonl
esp_log.bin
drivelogs/
